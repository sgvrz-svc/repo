<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>			<string>DNS</string>
	<key>PayloadType</key>					<string>Configuration</string>
	<key>PayloadIdentifier</key>			<string>com.apple.dns</string>
	<key>PayloadUUID</key>					<string>AABBCCDD-0100-EEFF-0000-ABCDEF000000</string>
	<key>PayloadOrganization</key>			<string>SU</string>
	<key>PayloadScope</key>					<string>System</string>
	<key>PayloadVersion</key>				<integer>1</integer>

	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>				<string>AdGuard Home</string>
			<key>PayloadOrganization</key>				<string>dns.sgvrz.net</string>
			<key>PayloadType</key>						<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>						<string>AABBCCDD-0100-EEFF-0100-ABCDEF000000</string>
			<key>PayloadIdentifier</key>				<string>com.apple.dnsSettings.managed.AABBCCDD-0100-EEFF-0100-ABCDEF000000</string>
			<key>PayloadVersion</key>					<integer>1</integer>

			<key>ProhibitDisablement</key>				<true/>
			<key>DNSSettings</key>
			<dict>
				<key>AllowFailover</key>				<false/>
				<key>ServerAddreses</key>
				<array>
					<string>0.0.0.0</string>
				</array>
				<key>DNSProtocol</key>					<string>HTTPS</string>
				<key>ServerURL</key>					<string>https://0.0.0.0/</string>
			</dict>

			<key>OnDemandRules</key>
			<array>
				<dict>
					<key>Action</key>					<string>EvaluateConnection</string>
					<key>ActionParameters</key>
					<array>
						<dict>
							<key>DomainAction</key>		<string>NeverConnect</string>
							<key>Domains</key>
							<array>
								<string>*.local</string>
								<string>*.lan</string>
								<string>*.backloop.dev</string>

								<string>apple.com</string>
								<string>icloud.com</string>
								<string>mzstatic.com</string>

								<string>starline.ru</string>
								
								<string>maps.yango.*</string>
								<string>maps.yandex.*</string>
								<string>strm.yandex.*</string>
								<string>music.yandex.*</string>
								<string>tanker.yandex.*</string>
								<string>tanker.s3.yandex.*</string>
								<string>passport.yandex.*</string>

                                <string>disk.2gis.*</string>
								<string>tugc.2gis.*</string>
								<string>maps.2gis.*</string>
								<string>jam.api.2gis.*</string>
								<string>hybrid.api.2gis.*</string>
								<string>transport.api.2gis.*</string>
								<string>map-settings.api.2gis.*</string>
								<string>dangerous-cameras.api.2gis.*</string>
							</array>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
	</array>
</dict>
</plist>